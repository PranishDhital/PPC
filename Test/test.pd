// Single line comment
/*
    Multi line comment
*/

let x = 1.5;
let y = x + 2.25;
printnl (1+1);
printnl ("Hello" + "world");
printnl ("value of x is : " + x);
printnl (y);
print("Enter ur age: ");
let age = 0;
input (age);
print("\n");
printnl(age);

// if conditions
if (age < 18)
{
    printnl("You are young");
} else if (age >= 18)
{
    printnl("You are an adult");
}
else
{
    print("Error");
}

let i = 0;
while (i!= 10)
{
    print (i);
    i++;
}

