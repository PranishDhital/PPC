// This is a single line comment
/* This is a
   multi-line comment. */

let age;
let threshold = 18;
let decimal_value = 3.14;
let temperature = -5.5;
string name;
string greeting = "Hello, ";

print("Enter your age: ");
input(age);
printnl("Enter your name (spaces are allowed): ");
input(name);

printnl(greeting + name);
printnl("Age: " + age);
printnl("Decimal example: " + decimal_value);
printnl("Negative example: " + temperature);

// Arithmetic operators: + - * /
let arithmetic = (age + 2) * 3 / 2 - 1;
printnl(arithmetic);

// Comparison operators: < <= > >= == !=, plus logical negation !
if (!(age < 0)) {
    printnl("Age is not negative");
}

if (age >= threshold) {
    printnl("Adult");
} else if (age == 13) {
    printnl("Teenager");
} else if (age <= 17) {
    printnl("Teenager or child");
} else if (age != 0) {
    printnl("Child or young adult");
} else {
    printnl("Age is zero or invalid");
}

if (age > 0) {
    printnl("Age is positive");
}

// Prefix and postfix increment/decrement: ++ --
let counter = 0;
++counter;
counter++;
--counter;
counter--;

while (counter < 2) {
    counter++;
    print(counter);
}

for (let index = 0; index <= 2; index++) {
    printnl("Loop index: " + index);
}

// String escape sequences: \n, \t, \", and \\
printnl("Escapes: newline\n tab\t quote\" slash\\");

exit(0);
